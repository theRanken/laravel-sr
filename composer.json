{
    "name": "theranken/laravel-sr-generator",
    "description": "A package to generate service and repository classes for Laravel 10-13 applications",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ranken\\ServiceRepositoryGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ranken\\ServiceRepositoryGenerator\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ranken\\ServiceRepositoryGenerator\\ServiceRepositoryServiceProvider"
            ]
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Rankencorp",
            "email": "rankencorp@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
